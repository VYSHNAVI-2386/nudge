generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  passwordHash  String?
  firebaseUid   String?        @unique
  fcmToken      String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  reminders     Reminder[]
  circle        CircleMember[] @relation("UserCircle")
  refreshTokens RefreshToken[]
}

model CircleMember {
  id        String     @id @default(cuid())
  userId    String
  name      String
  phone     String?
  companion String     @default("bear")
  createdAt DateTime   @default(now())
  user      User       @relation("UserCircle", fields: [userId], references: [id], onDelete: Cascade)
  reminders Reminder[]
}

model Reminder {
  id          String        @id @default(cuid())
  userId      String
  recipientId String
  title       String
  message     String
  time        String
  repeat      String        @default("daily")
  companion   String        @default("bear")
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient   CircleMember  @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  logs        ReminderLog[]
}

model ReminderLog {
  id         String    @id @default(cuid())
  reminderId String
  sentAt     DateTime  @default(now())
  markedDone Boolean   @default(false)
  doneAt     DateTime?
  reminder   Reminder  @relation(fields: [reminderId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
